# Production Dockerfile for FastAPI backend
# Stage 1: Build dependencies and wheels
FROM python:3.11-slim AS builder

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends gcc build-essential libmariadb-dev-compat libmariadb-dev \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .

# Build wheels to speed up final stage installation and minimize size
RUN pip wheel --no-cache-dir --no-deps --wheel-dir /app/wheels -r requirements.txt


# Stage 2: Final minimal production image
FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV PORT=8000

WORKDIR /app

# Install runtime database client libraries (required if using MySQL/MariaDB driver)
RUN apt-get update \
    && apt-get install -y --no-install-recommends libmariadb-dev-compat libmariadb-dev \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Copy built wheels from builder stage
COPY --from=builder /app/wheels /wheels
COPY --from=builder /app/requirements.txt .

# Install dependencies from wheels
RUN pip install --no-cache-dir --no-index --find-links=/wheels -r requirements.txt \
    && rm -rf /wheels

# Copy application source code
COPY . .

# Create a non-privileged user and group for security hardening
RUN groupadd -g 10001 appuser \
    && useradd -u 10001 -g appuser -s /bin/bash -m appuser \
    && chown -R appuser:appuser /app

# Switch to the non-root user
USER appuser

# Expose production port
EXPOSE 8000

# Start FastAPI application in production mode without reload, utilizing single process or workers
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "4"]
