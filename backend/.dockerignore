# Ignore python cache
__pycache__/
*.pyc
*.pyo
*.pyd

# Ignore local virtual environments
.venv/
venv/
env/
ENV/

# Ignore SQLite database files to avoid copying development DB to container
*.db
*.db.bak

# Ignore local configuration and secrets
.env
.env.local

# Ignore OS files
.DS_Store
Thumbs.db

# Ignore Git directory
.git/
.gitignore

# Ignore logs
*.log
logs/
uploads/
